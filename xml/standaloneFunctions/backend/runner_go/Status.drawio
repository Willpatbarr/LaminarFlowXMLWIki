<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" parent="1" style="rounded=0;html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=14;whiteSpace=wrap;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;LaminarFlow-Backend/internal/migrate/runner.go&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" y="260" as="geometry"/></mxCell><mxCell id="3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;&lt;font face=&quot;Andale Mono&quot;&gt;package migrate&lt;/font&gt; — &lt;font face=&quot;Andale Mono&quot;&gt;+ Status&lt;/font&gt; is exported; backs the migrate command&#39;s status listing&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;the whole body is one &lt;a href=&quot;#func#withLock&quot;&gt;withLock&lt;/a&gt; closure, and it builds a slice rather than a map so the order is file order first&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="40" width="700" y="290" as="geometry"/></mxCell><mxCell id="4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;func &lt;b&gt;Status(&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;ctx context.Context&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;pool *pgxpool.Pool&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;migrations []&lt;a href=&quot;#class#Migration&quot;&gt;Migration&lt;/a&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;)&lt;/b&gt; ([]&lt;a href=&quot;#class#Record&quot;&gt;Record&lt;/a&gt;, error)&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="100" width="700" y="330" as="geometry"/></mxCell><mxCell id="5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Returns one &lt;a href=&quot;#class#Record&quot;&gt;Record&lt;/a&gt; per known migration, in file order, with Applied read from schema_migrations — then one extra Record for every&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;version the database has recorded that no longer has a file, named &amp;quot;(file missing)&amp;quot; and Applied true. The error is the first&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;failure from the lock or the schema_migrations read, in which case the slice is empty.&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="60" width="700" y="430" as="geometry"/></mxCell><mxCell id="6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;-&amp;gt; return records, err&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" y="490" as="geometry"/></mxCell><mxCell id="7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;var records []&lt;a href=&quot;#class#Record&quot;&gt;Record&lt;/a&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;err := &lt;a href=&quot;#func#withLock&quot;&gt;withLock&lt;/a&gt;(ctx, pool, func(ctx context.Context, conn *pgxpool.Conn) error {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;applied, err := &lt;a href=&quot;#func#appliedVersions&quot;&gt;appliedVersions&lt;/a&gt;(ctx, conn)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if err != nil {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;return err&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;known := make(map[int64]bool, len(migrations))&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;for _, m := range migrations {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;known[m.Version] = true&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;records = append(records, Record{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;Version: m.Version,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;Name:    m.Name,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;Applied: applied[m.Version],&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;})&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;for v := range applied {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if !known[v] {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;records = append(records,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;Record{Version: v, Name: &amp;quot;(file missing)&amp;quot;, Applied: true})&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;return nil&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;})&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;return records, err&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;a version recorded in the database with no file behind it means someone deleted a migration that has already run somewhere&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;— the runner cannot undo that, and should not hide it, so it is listed as &amp;quot;(file missing)&amp;quot; instead of being dropped&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="680" width="700" y="520" as="geometry"/></mxCell></root></mxGraphModel>
