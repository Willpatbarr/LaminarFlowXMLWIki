<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" parent="1" style="rounded=0;html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=14;whiteSpace=wrap;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;LaminarFlow-Backend/internal/migrate/migrate.go&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" y="260" as="geometry"/></mxCell><mxCell id="3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font face=&quot;Andale Mono&quot;&gt;package migrate&lt;/font&gt; — the loader; a package rather than a script because the migrate command and the test bootstrap both call it&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;the source declares it as Load; it is carded as migrate_Load because internal/config&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;declares a Load of its own (carded as &lt;a href=&quot;#func#config_Load&quot;&gt;config_Load&lt;/a&gt;) and wiki function names are unique&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;the file also declares package-level values that get no cards of their own: the advisory-lock id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;lockID and the sentinel ErrIrreversible, both used by runner.go; the filename regexp&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;^(\d+)_(.+)\.sql$ used here; and the sectionUp / sectionDown markers used by &lt;a href=&quot;#func#split&quot;&gt;split&lt;/a&gt;()&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="120" width="700" y="290" as="geometry"/></mxCell><mxCell id="4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;func &lt;b&gt;Load(&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;fsys fs.FS&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;)&lt;/b&gt; ([]&lt;a href=&quot;#class#Migration&quot;&gt;Migration&lt;/a&gt;, error)&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="60" width="700" y="410" as="geometry"/></mxCell><mxCell id="5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Returns every migration in fsys as a []&lt;a href=&quot;#class#Migration&quot;&gt;Migration&lt;/a&gt; sorted ascending by Version, and an&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;error that is nil on success. The error is non-nil for five things, and on any of&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;them the slice comes back nil rather than partial: a filename that does not match&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;NNNN_name.sql (or whose numeric prefix will not parse as an int64); two files&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;sharing a version, named in the message; a directory entry or file that cannot be&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;read; a body &lt;a href=&quot;#func#split&quot;&gt;split&lt;/a&gt;() rejects — missing Up marker, missing Down marker, empty Up&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;section; and the directory holding no .sql migrations at all.&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="140" width="700" y="470" as="geometry"/></mxCell><mxCell id="6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;-&amp;gt; return migrations, nil&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;-&amp;gt; return nil, fmt.Errorf(...) // read, filename, version, duplicate, split&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;-&amp;gt; return nil, errors.New(&quot;no migrations found&quot;)&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="60" width="700" y="610" as="geometry"/></mxCell><mxCell id="7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;entries, err := fs.ReadDir(fsys, &quot;.&quot;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if err != nil { return nil, fmt.Errorf(&quot;read migrations: %w&quot;, err) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;var migrations []&lt;a href=&quot;#class#Migration&quot;&gt;Migration&lt;/a&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;seen := make(map[int64]string)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;for _, e := range entries {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if e.IsDir() || !strings.HasSuffix(e.Name(), &quot;.sql&quot;) { continue }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;match := filename.FindStringSubmatch(e.Name())&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if match == nil {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;return nil, fmt.Errorf(&quot;migration %q does not match NNNN_name.sql&quot;, e.Name())&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;version, err := strconv.ParseInt(match[1], 10, 64)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if err != nil {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;return nil, fmt.Errorf(&quot;migration %q has an unparseable version: %w&quot;, e.Name(), err)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if prev, dup := seen[version]; dup {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;return nil, fmt.Errorf(&quot;migrations %q and %q share version %d&quot;, prev, e.Name(), version)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;seen[version] = e.Name()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;body, err := fs.ReadFile(fsys, e.Name())&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if err != nil { return nil, fmt.Errorf(&quot;read %s: %w&quot;, e.Name(), err) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;up, down, err := &lt;a href=&quot;#func#split&quot;&gt;split&lt;/a&gt;(string(body))&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;if err != nil { return nil, fmt.Errorf(&quot;%s: %w&quot;, e.Name(), err) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;migrations = append(migrations, &lt;a href=&quot;#class#Migration&quot;&gt;Migration&lt;/a&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;Version: version, Name: match[2], Up: up, Down: down,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;})&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if len(migrations) == 0 { return nil, errors.New(&quot;no migrations found&quot;) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;sort.Slice(migrations, func(i, j int) bool {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;return migrations[i].Version &amp;lt; migrations[j].Version&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;})&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;return migrations, nil&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;it fails rather than guessing, on purpose: a migration the runner cannot read is one it would&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;otherwise silently skip, and a schema that quietly diverges from the files is worse than a&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;runner that refuses to start&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;seen keys a version to the filename that claimed it, so the duplicate error can name both files&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;non-.sql entries and subdirectories are skipped, not rejected — README.md lives in there too&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;sorting happens once at the end, so whatever order fs.ReadDir hands back never matters&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="1000" width="700" y="670" as="geometry"/></mxCell></root></mxGraphModel>
