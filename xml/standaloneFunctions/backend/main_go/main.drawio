<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" parent="1" style="rounded=0;html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=14;whiteSpace=wrap;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;LaminarFlow-Backend/main.go&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" y="260" as="geometry"/></mxCell><mxCell id="3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font face=&quot;Andale Mono&quot;&gt;package main&lt;/font&gt; — the server binary&#39;s entry point, and its own container healthcheck&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;the file&#39;s only const block holds healthcheckTimeout = 2 * time.Second, used by healthcheck()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;short on purpose — a healthcheck that hangs is indistinguishable from one that failed&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="70" width="700" y="290" as="geometry"/></mxCell><mxCell id="4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;func &lt;b&gt;main()&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" y="360" as="geometry"/></mxCell><mxCell id="5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Returns nothing — blocks inside http.ListenAndServe, or exits the process before it&lt;/font&gt;" vertex="1"><mxGeometry height="30" width="700" y="390" as="geometry"/></mxCell><mxCell id="6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;-&amp;gt; void (os.Exit in healthcheck mode; log.Fatalf on any startup failure)&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" y="420" as="geometry"/></mxCell><mxCell id="7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if len(os.Args) &amp;gt; 1 &amp;amp;&amp;amp; os.Args[1] == &quot;healthcheck&quot; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;os.Exit(&lt;a href=&quot;#func#healthcheck&quot;&gt;healthcheck&lt;/a&gt;())&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;cfg, err := &lt;a href=&quot;#func#config_Load&quot;&gt;config.Load&lt;/a&gt;()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if err != nil { log.Fatalf(&quot;config: %v&quot;, err) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;pool, err := &lt;a href=&quot;#func#Connect&quot;&gt;db.Connect&lt;/a&gt;(context.Background(), cfg.DatabaseURL)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if err != nil { log.Fatalf(&quot;database: %v&quot;, err) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;defer pool.Close()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;log.Print(&quot;connected to postgres&quot;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if err := &lt;a href=&quot;#func#ensureSchema&quot;&gt;ensureSchema&lt;/a&gt;(context.Background(), pool, cfg.MigrateOnStartup); err != nil {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp; &amp;nbsp;log.Fatalf(&quot;schema: %v&quot;, err)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;bundle, err := &lt;a href=&quot;#func#frontendFS&quot;&gt;frontendFS&lt;/a&gt;(cfg.FrontendDir)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;if err != nil { log.Fatalf(&quot;frontend: %v&quot;, err) }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;mux := &lt;a href=&quot;#func#NewMux&quot;&gt;api.NewMux&lt;/a&gt;(pool, bundle)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;addr := &quot;:&quot; + cfg.Port&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;log.Printf(&quot;laminarflow backend listening on %s&quot;, addr)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; &amp;nbsp;log.Fatal(http.ListenAndServe(addr, mux))&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;the healthcheck branch is handled before anything else, so a distroless image (no shell,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;no curl) can check itself without opening a database connection or reading config&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;everything after it fails fast — bad config, unreachable Postgres or a pending migration&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;exits here rather than serving a broken backend&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="640" width="700" y="450" as="geometry"/></mxCell></root></mxGraphModel>
