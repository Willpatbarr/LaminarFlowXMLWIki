<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" parent="1" style="rounded=0;html=1;align=left;verticalAlign=middle;spacingLeft=6;fontSize=14;whiteSpace=wrap;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;LaminarFlow-Backend/internal/config/config.go&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" x="850" y="980" as="geometry"/></mxCell><mxCell id="3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font face=&quot;Andale Mono&quot;&gt;type … struct&lt;/font&gt; — a plain settings value in &lt;font face=&quot;Andale Mono&quot;&gt;package config&lt;/font&gt;, read once at startup&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;no NewX factory and no methods — &lt;a href=&quot;#func#config_Load&quot;&gt;config_Load&lt;/a&gt;() is what builds a populated Config&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="50" width="700" x="850" y="1010" as="geometry"/></mxCell><mxCell id="4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font&gt;type &lt;b&gt;Config&lt;/b&gt; struct&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="700" x="850" y="1060" as="geometry"/></mxCell><mxCell id="5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Andale Mono;fontSize=14;resizeHeight=1;autosize=0;fixedWidth=1;" value="&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;Attributes&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;+ Port: string&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;+ DatabaseURL: string&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;+ MigrateOnStartup: bool&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;+ FrontendDir: string&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;all four are exported (+); every one comes straight from an env var&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;Port falls back to the package const DefaultPort (&quot;8080&quot;); DatabaseURL has no&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;default at all, and an empty one is what ErrMissingDatabaseURL reports&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;MigrateOnStartup is off unless MIGRATE_ON_STARTUP is exactly &quot;true&quot;;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;FrontendDir empty means serve the embedded bundle&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="220" width="700" x="850" y="1090" as="geometry"/></mxCell></root></mxGraphModel>
